POSTGRES_DB=customer_journey
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

CLICKHOUSE_DB=customer_journey
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Optional (unused unless you secure Redis with requirepass)
REDIS_PASSWORD=

# n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
N8N_TIMEZONE=UTC
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
BITENEX_API_BASE_URL=http://host.docker.internal:8000/api/v1
BITENEX_INTERNAL_API_KEY=replace_with_internal_api_token
