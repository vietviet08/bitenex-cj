# Docker Compose service credentials
POSTGRES_DB=cj
POSTGRES_USER=app
POSTGRES_PASSWORD=app

CLICKHOUSE_DB=cj
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Optional (unused unless you secure Redis with requirepass)
REDIS_PASSWORD=

# API settings (optional, kept in sync with apps/api/.env.example)
API_PORT=8000
DEBUG=false
API_PREFIX=/v1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_journey
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=customer_journey
REDIS_URL=redis://localhost:6379/0
EVENT_RETENTION_DAYS=90
MAX_EVENT_PAYLOAD_KB=32
JWT_SECRET_KEY=change-me-in-production-use-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
