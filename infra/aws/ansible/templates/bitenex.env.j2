# Application
APP_NAME={{ bitenex_app_name }}
APP_ENV={{ bitenex_app_env }}
DEBUG={{ bitenex_debug | ternary('true', 'false') }}
API_VERSION={{ bitenex_api_version }}
SECRET_KEY={{ vault_bitenex_secret_key }}

# Database
DATABASE_URL=postgresql+asyncpg://{{ bitenex_database_user }}:{{ vault_bitenex_database_password }}@{{ bitenex_database_host }}:{{ bitenex_database_port }}/{{ bitenex_database_name }}
DATABASE_SSL={{ bitenex_database_sslmode }}
DATABASE_ECHO={{ bitenex_database_echo | ternary('true', 'false') }}

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Configuration
JWT_SECRET_KEY={{ vault_bitenex_jwt_secret_key }}
JWT_ALGORITHM={{ bitenex_jwt_algorithm }}
ACCESS_TOKEN_EXPIRE_MINUTES={{ bitenex_access_token_expire_minutes }}
REFRESH_TOKEN_EXPIRE_DAYS={{ bitenex_refresh_token_expire_days }}

# CORS
CORS_ORIGINS={{ bitenex_cors_origins | to_json }}

# WebSocket
WS_MESSAGE_QUEUE_SIZE={{ bitenex_ws_message_queue_size }}

# VNPAY
VNP_TMN_CODE={{ vault_bitenex_vnp_tmn_code }}
VNP_HASH_SECRET={{ vault_bitenex_vnp_hash_secret }}
VNP_URL={{ bitenex_vnp_url }}
VNP_RETURN_URL={{ bitenex_vnp_return_url }}
VNP_IPN_URL={{ bitenex_vnp_ipn_url }}

INTERNAL_API_TOKEN={{ vault_bitenex_internal_api_token }}

N8N_BASE_URL={{ bitenex_n8n_base_url }}
N8N_WEBHOOK_SECRET={{ vault_bitenex_n8n_webhook_secret }}
N8N_WEBHOOK_ENABLED={{ bitenex_n8n_webhook_enabled | ternary('true', 'false') }}

FIREBASE_PROJECT_ID={{ bitenex_firebase_project_id }}
FIREBASE_CREDENTIALS_PATH={{ bitenex_firebase_credentials_path | default('/app/firebase-credentials.json', true) }}
FIREBASE_CREDENTIALS_JSON={{ bitenex_firebase_credentials_json | default('') }}

SMTP_USER={{ vault_bitenex_smtp_user }}
SMTP_PASSWORD={{ vault_bitenex_smtp_password }}
SMTP_HOST={{ bitenex_smtp_host }}
SMTP_PORT={{ bitenex_smtp_port }}
SMTP_TLS_SSL={{ bitenex_smtp_tls_ssl | ternary('true', 'false') }}

# Compose runtime
API_BIND_ADDRESS={{ bitenex_api_bind_address }}
API_PORT={{ bitenex_api_port }}
N8N_BIND_ADDRESS={{ bitenex_n8n_bind_address }}
N8N_PORT={{ bitenex_n8n_port }}
N8N_IMAGE_TAG={{ n8n_version }}
PGADMIN_BIND_ADDRESS={{ pgadmin_bind_address }}
PGADMIN_PORT={{ pgadmin_port }}
SONARQUBE_BIND_ADDRESS={{ sonarqube_bind_address }}
SONARQUBE_PORT={{ sonarqube_port }}
SONARQUBE_IMAGE={{ sonarqube_image }}
SONARQUBE_POSTGRES_DB={{ sonarqube_postgres_db }}
SONARQUBE_POSTGRES_USER={{ sonarqube_postgres_user }}
SONARQUBE_POSTGRES_PASSWORD={{ vault_sonarqube_postgres_password }}
