        "jsCode": "// Rate limiter - max 10 requests per second\nconst MAX_PER_SECOND = 10;\nconst items = $input.all()[0].json.items || [];\nconst delay = Math.ceil(1000 / MAX_PER_SECOND);\n\nreturn items.map(item => ({\n  ...item,\n  throttle_delay: delay,\n  priority: item.current_stock <= 5 ? 'high' : 'medium'\n}));"
      },
