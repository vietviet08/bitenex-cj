            "index": 0
          },
          {
            "node": "Send: Payment Failure Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send: Payment Failure Push": {
      "main": [
        [
          {
            "node": "Wait 1 hour",
