            "index": 0
          }
        ]
      ]
    },
    "IF: Payment Recovered?": {
      "main": [
        [
          {
            "node": "Track: payment_recovered",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "IF: COD Available?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: COD Available?": {
      "main": [
        [
          {
            "node": "Offer: COD Alternative Push",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "SMS: Final Attempt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMS: Final Attempt": {
      "main": [
        [
          {
            "node": "Cancel: Order (Final)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
