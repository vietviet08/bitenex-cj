{
  "name": "Onboarding Sequence (Webhook)",
  "nodes": [
    {
      "parameters": {
        "path": "onboarding",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseCode": 200
      },
      "id": "1",
      "name": "Webhook Onboarding",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "language": "JavaScript",
        "jsCode": "return items.map(item => {\n  const data = item.json;\n  if (!data.dedupe_key) {\n    const id = data.user_id || data.anonymous_id || 'unknown';\n    data.dedupe_key = `onboarding:${id}`;\n  }\n  if (!data.dedupe_ttl_seconds) data.dedupe_ttl_seconds = 31536000;\n  return item;\n});"
      },
      "id": "2",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "key": "={{$node[\"Normalize Payload\"].json[\"dedupe_key\"]}}"
      },
      "id": "3",
      "name": "Redis Get Dedupe",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "redis": {
          "id": "1",
          "name": "Redis"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"value\"]}}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "id": "4",
      "name": "Dedupe Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [860, 300]
    },
    {
      "parameters": {},
      "id": "5",
      "name": "Stop (Already Sent)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1080, 200]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "={{$node[\"Normalize Payload\"].json[\"dedupe_key\"]}}",
        "value": "1",
        "expire": "={{$node[\"Normalize Payload\"].json[\"dedupe_ttl_seconds\"] || 31536000}}"
      },
      "id": "6",
      "name": "Redis Set Dedupe",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1080, 400],
      "credentials": {
        "redis": {
          "id": "1",
          "name": "Redis"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT email, phone FROM users WHERE id = '{{$node[\"Normalize Payload\"].json[\"user_id\"]}}';"
