                    }
                ]
            ]
        },
        "Filter No First Order Yet": {
            "main": [
                [
                    {
                        "node": "Send Welcome Nudge",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send Welcome Nudge": {
            "main": [
                [
                    {
                        "node": "Wait 6 Hours",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Wait 6 Hours": {
            "main": [
                [
                    {
                        "node": "Recheck First Order Status",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Recheck First Order Status": {
            "main": [
                [
                    {
                        "node": "Filter Still No First Order",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Filter Still No First Order": {
            "main": [
                [
                    {
                        "node": "Issue First Order Voucher",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "pinData": {},
    "active": false,
    "settings": {},
    "versionId": "onboarding-first-order-v1",
