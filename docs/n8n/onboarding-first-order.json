{
    "name": "Bitenex - Onboarding to First Order",
    "nodes": [
        {
            "parameters": {
                "path": "bitenex/onboarding-first-order",
                "httpMethod": "POST",
                "responseMode": "onReceived",
                "options": {}
            },
            "id": "1",
            "name": "Webhook User Registered",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                -840,
                80
            ],
            "webhookId": "bitenex-onboarding-first-order"
        },
        {
            "parameters": {
                "keepOnlySet": false,
                "values": {
                    "string": [
                        {
                            "name": "userId",
                            "value": "={{$json.body?.userId || $json.userId}}"
                        },
                        {
                            "name": "firstName",
                            "value": "={{$json.body?.firstName || $json.firstName || 'Customer'}}"
                        },
                        {
                            "name": "email",
                            "value": "={{$json.body?.email || $json.email || ''}}"
                        },
                        {
                            "name": "phone",
                            "value": "={{$json.body?.phone || $json.phone || ''}}"
                        },
                        {
                            "name": "city",
                            "value": "={{$json.body?.city || $json.city || ''}}"
                        },
                        {
                            "name": "platform",
                            "value": "={{$json.body?.platform || $json.platform || 'app'}}"
                        },
                        {
                            "name": "deepLink",
                            "value": "={{$json.body?.deepLink || 'bitenex://home'}}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "2",
            "name": "Set Journey Context",
            "type": "n8n-nodes-base.set",
            "typeVersion": 2,
            "position": [
                -600,
                80
            ]
        },
        {
            "parameters": {
                "resume": "timeInterval",
                "amount": 10,
                "unit": "minutes"
            },
            "id": "3",
            "name": "Wait 10 Minutes",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1,
            "position": [
                -360,
                80
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/journeys/users/' + $node[\"Set Journey Context\"].json[\"userId\"] + '/first-order-status'}}",
                "options": {}
            },
            "id": "4",
            "name": "Check First Order Status",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                -120,
                80
            ]
        },
        {
            "parameters": {
                "jsCode": "if ($json.hasFirstOrder === true || Number($json.totalOrders || 0) > 0) {\n  return [];\n}\nreturn items;"
            },
            "id": "5",
            "name": "Filter No First Order Yet",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                120,
                80
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/notifications/push'}}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { userId: $node[\"Set Journey Context\"].json[\"userId\"], template: 'welcome_first_order', channels: ['push', 'email'], data: { firstName: $node[\"Set Journey Context\"].json[\"firstName\"], city: $node[\"Set Journey Context\"].json[\"city\"], deepLink: $node[\"Set Journey Context\"].json[\"deepLink\"] } } }}",
                "options": {}
            },
            "id": "6",
            "name": "Send Welcome Nudge",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                360,
                80
            ]
        },
        {
            "parameters": {
                "resume": "timeInterval",
                "amount": 6,
                "unit": "hours"
            },
            "id": "7",
            "name": "Wait 6 Hours",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1,
            "position": [
                600,
                80
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/journeys/users/' + $node[\"Set Journey Context\"].json[\"userId\"] + '/first-order-status'}}",
                "options": {}
            },
            "id": "8",
            "name": "Recheck First Order Status",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                840,
                80
            ]
        },
        {
            "parameters": {
                "jsCode": "if ($json.hasFirstOrder === true || Number($json.totalOrders || 0) > 0) {\n  return [];\n}\nreturn items;"
            },
            "id": "9",
            "name": "Filter Still No First Order",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1080,
                80
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/marketing/issue-voucher'}}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { userId: $node[\"Set Journey Context\"].json[\"userId\"], campaign: 'first_order_activation', voucherCodePrefix: 'WELCOME', offerType: 'free_ship', notification: { channels: ['push', 'email'], template: 'first_order_voucher', data: { firstName: $node[\"Set Journey Context\"].json[\"firstName\"], deepLink: 'bitenex://checkout' } } } }}",
                "options": {}
            },
            "id": "10",
            "name": "Issue First Order Voucher",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1320,
                80
            ]
        }
    ],
    "connections": {
        "Webhook User Registered": {
            "main": [
                [
                    {
                        "node": "Set Journey Context",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Set Journey Context": {
