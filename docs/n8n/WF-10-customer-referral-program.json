            {
              "name": "Authorization",
              "value": "={{'Bearer ' + ($env.BITENEX_INTERNAL_API_TOKEN || 'token')}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event_name\": \"referral_initiated\",\n  \"user_id\": {{JSON.stringify($json.referrer_id)}},\n  \"timestamp\": {{JSON.stringify($json.timestamp)}},\n  \"properties\": {\n    \"referral_code\": {{JSON.stringify($json.body.referral_code)}},\n    \"referee_id\": {{JSON.stringify($json.referee_id)}},\n    \"reward_amount\": {{$json.body.reward_amount || 50000}},\n    \"currency\": {{JSON.stringify($json.body.currency || 'VND')}}\n  }\n}",
        "options": {}
      },
