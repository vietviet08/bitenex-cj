    {
      "parameters": {
        "jsCode": "// Validate referral data and check for duplicates\nconst referrer_id = $json.body?.referrer_id;\nconst referee_id = $json.body?.referee_id;\n\nconst validation = {\n  valid: referrer_id && referee_id && referrer_id !== referee_id,\n  referrer_id: referrer_id,\n  referee_id: referee_id,\n  timestamp: new Date().toISOString(),\n  dedupe_key: 'referral_' + referrer_id + '_' + referee_id\n};\n\nif (!validation.valid) {\n  throw new Error('Invalid referral data or duplicate referrer/referee');\n}\n\nreturn [validation];"
      },
      "id": "b4c43f9d-3e11-410f-b973-39bef909dad0",
      "name": "Validate & Dedupe Referral",
