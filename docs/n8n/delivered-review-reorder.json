{
    "name": "Bitenex - Delivered Review and Reorder",
    "nodes": [
        {
            "parameters": {
                "path": "bitenex/delivered-review-reorder",
                "httpMethod": "POST",
                "responseMode": "onReceived",
                "options": {}
            },
            "id": "1",
            "name": "Webhook Order Delivered",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                -1020,
                160
            ],
            "webhookId": "bitenex-delivered-review-reorder"
        },
        {
            "parameters": {
                "keepOnlySet": false,
                "values": {
                    "string": [
                        {
                            "name": "userId",
                            "value": "={{$json.body?.userId || $json.userId}}"
                        },
                        {
                            "name": "orderId",
                            "value": "={{$json.body?.orderId || $json.orderId}}"
                        },
                        {
                            "name": "merchantName",
                            "value": "={{$json.body?.merchantName || $json.merchantName || 'Bitenex'}}"
                        },
                        {
                            "name": "deepLinkReview",
                            "value": "={{$json.body?.deepLinkReview || 'bitenex://order/food-rating'}}"
                        },
                        {
                            "name": "deepLinkReorder",
                            "value": "={{$json.body?.deepLinkReorder || 'bitenex://home'}}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "2",
            "name": "Set Delivery Context",
            "type": "n8n-nodes-base.set",
            "typeVersion": 2,
            "position": [
                -780,
                160
            ]
        },
        {
            "parameters": {
                "resume": "timeInterval",
                "amount": 20,
                "unit": "minutes"
            },
            "id": "3",
            "name": "Wait 20 Minutes",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1,
            "position": [
                -540,
                160
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/notifications/push'}}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { userId: $node[\"Set Delivery Context\"].json[\"userId\"], template: 'review_request_after_delivery', channels: ['push', 'email'], data: { orderId: $node[\"Set Delivery Context\"].json[\"orderId\"], merchantName: $node[\"Set Delivery Context\"].json[\"merchantName\"], deepLink: $node[\"Set Delivery Context\"].json[\"deepLinkReview\"] } } }}",
                "options": {}
            },
            "id": "4",
            "name": "Send Review Request",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                -300,
                160
            ]
        },
        {
            "parameters": {
                "resume": "timeInterval",
                "amount": 24,
                "unit": "hours"
            },
            "id": "5",
            "name": "Wait 24 Hours",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1,
            "position": [
                -60,
                160
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/journeys/orders/' + $node[\"Set Delivery Context\"].json[\"orderId\"] + '/review-status'}}",
                "options": {}
            },
            "id": "6",
            "name": "Check Review Status",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                180,
                160
            ]
        },
        {
            "parameters": {
                "jsCode": "if ($json.hasReview === true) {\n  return [];\n}\nreturn items;"
            },
            "id": "7",
            "name": "Filter Missing Review",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                420,
                40
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/notifications/push'}}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { userId: $node[\"Set Delivery Context\"].json[\"userId\"], template: 'review_reminder', channels: ['push'], data: { orderId: $node[\"Set Delivery Context\"].json[\"orderId\"], merchantName: $node[\"Set Delivery Context\"].json[\"merchantName\"], deepLink: $node[\"Set Delivery Context\"].json[\"deepLinkReview\"] } } }}",
                "options": {}
            },
            "id": "8",
            "name": "Send Review Reminder",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                660,
                40
            ]
        },
        {
            "parameters": {
                "jsCode": "if ($json.hasReview === true && Number($json.rating || 0) >= 4) {\n  return items;\n}\nreturn [];"
            },
            "id": "9",
            "name": "Filter Positive Review",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                420,
                280
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/marketing/issue-voucher'}}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { userId: $node[\"Set Delivery Context\"].json[\"userId\"], campaign: 'review_to_reorder', offerType: 'reorder_discount', metadata: { orderId: $node[\"Set Delivery Context\"].json[\"orderId\"], sourceRating: $json.rating }, notification: { channels: ['push', 'email'], template: 'reorder_offer_after_positive_review', data: { merchantName: $node[\"Set Delivery Context\"].json[\"merchantName\"], deepLink: $node[\"Set Delivery Context\"].json[\"deepLinkReorder\"] } } } }}",
                "options": {}
            },
            "id": "10",
            "name": "Issue Reorder Voucher",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                660,
                280
            ]
        },
        {
            "parameters": {
                "resume": "timeInterval",
                "amount": 3,
                "unit": "days"
            },
            "id": "11",
            "name": "Wait 3 Days",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1,
            "position": [
                900,
                280
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/journeys/users/' + $node[\"Set Delivery Context\"].json[\"userId\"] + '/reorder-status?sinceOrderId=' + $node[\"Set Delivery Context\"].json[\"orderId\"]}}",
                "options": {}
            },
            "id": "12",
            "name": "Check Reorder Status",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1140,
                280
            ]
        },
        {
            "parameters": {
                "jsCode": "if ($json.hasReorderedSinceDelivery === true) {\n  return [];\n}\nreturn items;"
            },
            "id": "13",
            "name": "Filter No Reorder Yet",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1380,
                280
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$env.BITENEX_API_BASE_URL + '/internal/notifications/push'}}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { userId: $node[\"Set Delivery Context\"].json[\"userId\"], template: 'reorder_reminder', channels: ['push'], data: { merchantName: $node[\"Set Delivery Context\"].json[\"merchantName\"], deepLink: $node[\"Set Delivery Context\"].json[\"deepLinkReorder\"] } } }}",
                "options": {}
            },
            "id": "14",
            "name": "Send Reorder Reminder",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1620,
                280
            ]
        }
    ],
    "connections": {
