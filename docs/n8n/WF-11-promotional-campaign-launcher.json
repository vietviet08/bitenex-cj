      "parameters": {
        "jsCode": "// Validate and rate limit campaigns\nconst MAX_CAMPAIGNS = 100;\nconst campaigns = $input.all()[0].json.campaigns || [];\nconst validated = {\n  success: Array.isArray(campaigns) && campaigns.length > 0,\n  count: campaigns.length,\n  campaigns: campaigns.slice(0, MAX_CAMPAIGNS),\n  rate_limit: Math.ceil(1000 / Math.min(campaigns.length, 10)),\n  timestamp: new Date().toISOString()\n};\nif (!validated.success) {\n  throw new Error('No campaigns found');\n}\nreturn [validated];"
      },
