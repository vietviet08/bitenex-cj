            "typeVersion": 4.4
        },
        {
            "parameters": {
                "functionCode": "const orders = items[0].json.orders;\nconst freq = orders.length;\n\nlet topItems = {};\norders.forEach(o => {\n  o.items.forEach(i => {\n    topItems[i.name] = (topItems[i.name] || 0) + 1;\n  });\n});\n\nconst sorted = Object.entries(topItems)\n  .sort((a,b) => b[1] - a[1])\n  .slice(0,3)\n  .map(i => i[0]);\n\nreturn [{ json: { freq, topItems: sorted } }];"
            },
            "id": "8381f3ae-0a16-4e11-870f-ca4f64bfca1b",
            "name": "Analyze Behavior",
            "type": "n8n-nodes-base.function",
            "position": [-608, 256],
            "typeVersion": 1
        },
        {
            "parameters": {
                "conditions": {
                    "number": [
