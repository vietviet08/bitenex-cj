{
  "name": "Abandoned Cart Reminder (Webhook)",
  "nodes": [
    {
      "parameters": {
        "path": "abandoned-cart",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseCode": 200
      },
      "id": "1",
      "name": "Webhook Abandoned Cart",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "language": "JavaScript",
        "jsCode": "return items.map(item => {\n  const data = item.json;\n  if (!data.dedupe_key) {\n    const id = data.user_id || data.anonymous_id || 'unknown';\n    const date = (data.event_time || data.timestamp || new Date().toISOString()).slice(0, 10);\n    data.dedupe_key = `abandoned_cart:${id}:${date}`;\n  }\n  if (!data.dedupe_ttl_seconds) data.dedupe_ttl_seconds = 86400;\n  return item;\n});"
      },
      "id": "2",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "key": "={{$node[\"Normalize Payload\"].json[\"dedupe_key\"]}}"
      },
      "id": "3",
      "name": "Redis Get Dedupe",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "redis": {
          "id": "1",
          "name": "Redis"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"value\"]}}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "id": "4",
      "name": "Dedupe Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [860, 300]
    },
    {
      "parameters": {},
      "id": "5",
      "name": "Stop (Already Sent)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1080, 200]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "={{$node[\"Normalize Payload\"].json[\"dedupe_key\"]}}",
        "value": "1",
        "expire": "={{$node[\"Normalize Payload\"].json[\"dedupe_ttl_seconds\"] || 86400}}"
      },
      "id": "6",
      "name": "Redis Set Dedupe",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1080, 400],
      "credentials": {
        "redis": {
          "id": "1",
          "name": "Redis"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$node[\"Normalize Payload\"].json[\"user_id\"]}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "7",
      "name": "Has user_id?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1290, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT email, phone FROM users WHERE id = '{{$node[\"Normalize Payload\"].json[\"user_id\"]}}';"
      },
      "id": "8",
      "name": "Lookup User",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1500, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"email\"]}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "9",
      "name": "Has Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1710, 300]
    },
    {
      "parameters": {
        "fromEmail": "no-reply@example.com",
        "toEmail": "={{$json[\"email\"]}}",
        "subject": "You left items in your cart",
        "text": "We saved your items. Complete your order here: {{$node[\"Normalize Payload\"].json[\"properties\"] && $node[\"Normalize Payload\"].json[\"properties\"][\"checkout_url\"] ? $node[\"Normalize Payload\"].json[\"properties\"][\"checkout_url\"] : \"https://example.com/cart\"}}"
      },
      "id": "10",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1920, 220],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"phone\"]}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "11",
      "name": "Has Phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1920, 380]
    },
    {
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "+10000000000",
        "to": "={{$json[\"phone\"]}}",
        "message": "You left items in your cart. Complete your order: {{$node[\"Normalize Payload\"].json[\"properties\"] && $node[\"Normalize Payload\"].json[\"properties\"][\"checkout_url\"] ? $node[\"Normalize Payload\"].json[\"properties\"][\"checkout_url\"] : \"https://example.com/cart\"}}"
      },
      "id": "12",
      "name": "Send SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [2130, 380],
      "credentials": {
        "twilioApi": {
          "id": "1",
          "name": "Twilio"
        }
      }
    },
    {
      "parameters": {},
      "id": "13",
      "name": "Stop (Anonymous)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1500, 500]
    },
    {
      "parameters": {},
      "id": "14",
      "name": "Stop (No Contact)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2130, 520]
    }
  ],
